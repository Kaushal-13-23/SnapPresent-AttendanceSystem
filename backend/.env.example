# MongoDB Configuration
# For local development: mongodb://localhost:27017/
# For cloud deployment (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/
DATABASE_NAME=facerecognition
COLLECTION_NAME=students

# Face Recognition
THRESHOLD=0.6

# Server & CORS
FLASK_ENV=production
FLASK_DEBUG=0
# Set to your deployed frontend domain (e.g., https://snappresent.vercel.app) or * to allow all
FRONTEND_URL=*
